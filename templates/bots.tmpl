{{ template "header" . }}
{{ template "nav" . }}
{{ template "status" . }}

{{ if not .isLogged }}
<article style="
  text-align:center;
  margin-top:10vh;
">
  <strong>Not authenticated</strong>
  <p>Please log in.</p>
</article>

{{ else }}

<!-- CREATE BOT -->
<article style="
  max-width:500px;
  margin:40px auto;
  padding:24px;
  border-radius:12px;
  box-shadow:0 10px 30px rgba(0,0,0,0.4);
  display:flex;
  flex-direction:column;
  gap:16px;
">
  <strong>Create Bot</strong>

  <form method="POST" action="/bots/create" style="display:flex; flex-direction:column; gap:12px;">
    <input type="hidden" name="csrf" value="{{ .csrf }}">

    <label>
      Name
      <input name="name" required style="width:100%; padding:8px; margin-top:4px;">
    </label>

    <label>
      Token
      <input name="token" required style="width:100%; padding:8px; margin-top:4px;">
    </label>

    <label>
      Public Key
      <input name="public_key" required style="width:100%; padding:8px; margin-top:4px;">
    </label>

    <button type="submit" style="padding:10px;">Create</button>
  </form>
</article>

<!-- BOT LIST -->
<article style="
  max-width:900px;
  margin:40px auto;
  padding:24px;
  border-radius:12px;
  box-shadow:0 10px 30px rgba(0,0,0,0.4);
">
  <strong>Bots ({{ .total }})</strong>

  <div style="margin-top:16px; display:flex; flex-direction:column; gap:16px;">
    {{ range .bots }}
    <div style="
      padding:16px;
      border-radius:8px;
      border:1px solid #374151;
      display:flex;
      flex-direction:column;
      gap:10px;
    ">
      <div>
        <strong>{{ .Name }}</strong><br>
        <small>{{ .UUID }}</small><br>
        <small>{{ .PublicKey }}</small>
      </div>

      <!-- ACTIONS -->
      <div style="display:flex; gap:8px; flex-wrap:wrap;">

        <!-- VIEW -->
        <a href="/bots/{{ .UUID }}" style="padding:6px 10px; border:1px solid #555; border-radius:6px; text-decoration:none;">
          View
        </a>

        <!-- UPDATE NAME -->
        <form method="POST" action="/bots/{{ .UUID }}/update" style="display:flex; gap:6px;">
          <input type="hidden" name="csrf" value="{{ $.csrf }}">
          <input name="name" placeholder="New name" required style="padding:6px;">
          <button type="submit">Update</button>
        </form>

        <!-- DELETE -->
        <form method="POST" action="/bots/{{ .UUID }}/delete">
          <input type="hidden" name="csrf" value="{{ $.csrf }}">
          <button type="submit" style="background:#7f1d1d; color:white;">
            Delete
          </button>
        </form>

      </div>
    </div>
    {{ else }}
    <p>No bots found.</p>
    {{ end }}
  </div>
</article>

{{ end }}

{{ template "footer" . }}

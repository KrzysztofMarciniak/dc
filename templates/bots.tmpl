{{ template "header" . }}
{{ template "nav" . }}
{{ template "status" . }}

{{ if not .isLogged }}
<article style="text-align:center; margin-top:10vh;">
    <strong>Not authenticated</strong>
    <p>Please log in.</p>
</article>

{{ else }}
<article style="
  display:flex;
  gap:24px;
  max-width:1200px;
  margin:40px auto;
  align-items:flex-start;
  flex-wrap:wrap;
">
    <!-- LEFT: BOT LIST -->
    <div style="flex:2; min-width:320px;">
        <strong>Bots ({{ .total }})</strong>

        <div style="margin-top:16px; display:flex; flex-direction:column; gap:12px;">
            {{ range .bots }}
            <div style="
                display:flex;
                justify-content:space-between;
                align-items:center;
                padding:14px;
                border:1px solid #374151;
                border-radius:8px;
            ">
                <div>
                    <div style="font-weight:600;">{{ .Name }}</div>
                    <div style="font-size:12px; opacity: 0.8;">
                        ID: {{ .UUID }}<br>
                    </div>
                </div>
                <div>
                    <!-- VIEW DETAILS -->
                    <a href="/admin-panel/bots/{{ .UUID }}"
                        style="border:1px solid #555; padding:6px 12px; border-radius:6px; text-decoration:none; color:inherit; font-size: 14px;">
                        View Details
                    </a>
                </div>
            </div>
            {{ else }}
            <p>No bots found.</p>
            {{ end }}
        </div>
    </div>

    <!-- RIGHT: CREATE -->
    <div style="
    flex:1;
    min-width:280px;
    padding:24px;
    border-radius:12px;
    box-shadow:0 10px 30px rgba(0,0,0,0.4);
    display:flex;
    flex-direction:column;
    gap:20px;
  ">
        <a href="https://discord.com/developers/applications/" target="_blank" style="font-size: 14px; color: #5865F2;">Discord Developer Portal</a>

        <div>
            <strong>Create New Bot</strong>
            <form method="POST" action="/admin-panel/bots/create"
                style="display:flex; flex-direction:column; gap:10px; margin-top:10px;">
                <input type="hidden" name="csrf" value="{{ .csrf }}">

                <input name="name" placeholder="Display Name" required style="padding:10px; border:1px solid #374151; background: transparent; color: inherit; border-radius: 4px;">
                <input name="client_id" placeholder="Client ID" required style="padding:10px; border:1px solid #374151; background: transparent; color: inherit; border-radius: 4px;">
                <input name="token" type="password" placeholder="Bot Token" required style="padding:10px; border:1px solid #374151; background: transparent; color: inherit; border-radius: 4px;">

                <button type="submit" style="padding:12px; border:none; border-radius:6px; cursor:pointer; background:#5865F2; color:white; font-weight: 600; margin-top: 5px;">
                    Register Bot
                </button>
            </form>
        </div>
    </div>
</article>
{{ end }}
{{ template "footer" . }}

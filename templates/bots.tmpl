{{ template "header" . }}
{{ template "nav" . }}
{{ template "status" . }}

{{ if not .isLogged }}
<article style="text-align:center; margin-top:10vh;">
    <strong>Not authenticated</strong>
    <p>Please log in.</p>
</article>

{{ else }}
<article style="
  display:flex;
  gap:24px;
  max-width:1200px;
  margin:40px auto;
  align-items:flex-start;
  flex-wrap:wrap;
">
    <!-- LEFT: BOT LIST -->
    <div style="flex:2; min-width:320px;">
        <strong>Bots ({{ .total }})</strong>

        <div style="margin-top:16px; display:flex; flex-direction:column; gap:12px;">
            {{ range .bots }}
            <div style="
                display:flex;
                justify-content:space-between;
                align-items:center;
                padding:14px;
                border:1px solid #374151;
                border-radius:8px;
            ">
                <div>
                    <div style="font-weight:600;">{{ .Name }}</div>
                    <div style="font-size:12px; ">
                        ID: {{ .UUID }}
                    </div>
                </div>

                <div style="display:flex; gap:8px;">
                    <!-- SIMPLE POST BUTTON (No JS Fetch) -->
                    <form method="POST" action="/admin-panel/bots/{{ .UUID }}/verify" style="display:inline;">
                        <input type="hidden" name="csrf" value="{{ $.csrf }}">
                        <button type="submit"
                            style="border:1px solid #22c55e; padding:6px 10px; border-radius:6px; background:transparent; cursor:pointer; color:inherit;">
                            Check Status
                        </button>
                    </form>

                    <a href="/admin-panel/bots/{{ .UUID }}"
                        style="border:1px solid #555; padding:6px 10px; border-radius:6px; text-decoration:none; ">
                        View
                    </a>

                    <button onclick="openEdit('{{ .UUID }}', '{{ .Name }}')"
                        style="border:1px solid #555; padding:6px 10px; border-radius:6px;">
                        Edit
                    </button>

                    <button onclick="confirmDelete('{{ .UUID }}')"
                        style="border:none; padding:6px 10px; border-radius:6px;">
                        Delete
                    </button>
                </div>
            </div>
            {{ else }}
            <p>No bots found.</p>
            {{ end }}
        </div>
    </div>

    <!-- RIGHT: CREATE + EDIT -->
    <div style="
    flex:1;
    min-width:280px;
    padding:24px;
    border-radius:12px;
    box-shadow:0 10px 30px rgba(0,0,0,0.4);
    display:flex;
    flex-direction:column;
    gap:20px;
  ">
        <a href="https://discord.com/developers/applications/" target="_blank">Discord Developer System</a>

        <!-- CREATE -->
        <div>
            <strong>Create Bot</strong>
            <form method="POST" action="/admin-panel/bots/create"
                style="display:flex; flex-direction:column; gap:10px; margin-top:10px;">
                <input type="hidden" name="csrf" value="{{ .csrf }}">

                <input name="name" placeholder="Name" required style="padding:8px; border:1px solid #374151; ">
                <input name="token" type="password" placeholder="Token" required style="padding:8px; border:1px solid #374151; ">
                <input name="public_key" placeholder="Public Key" required style="padding:8px; border:1px solid #374151; ">

                <button type="submit" style="padding:10px; border:none; border-radius:6px; cursor:pointer;">Create</button>
            </form>
        </div>

        <!-- EDIT -->
        <div id="editBox" style="display:none;">
            <strong>Edit Bot</strong>
            <form method="POST" id="editForm"
                style="display:flex; flex-direction:column; gap:10px; margin-top:10px;">
                <input type="hidden" name="csrf" value="{{ .csrf }}">
                <input type="hidden" name="uuid" id="editUUID">

                <input name="name" id="editName" required style="padding:8px; border:1px solid #374151; ">

                <button type="submit" style="padding:10px; border:none; border-radius:6px; cursor:pointer;">Save</button>
            </form>
        </div>
    </div>
</article>

<script>
function openEdit(uuid, name) {
    const box = document.getElementById("editBox");
    const form = document.getElementById("editForm");
    document.getElementById("editUUID").value = uuid;
    document.getElementById("editName").value = name;
    form.action = "/admin-panel/bots/" + uuid + "/update";
    box.style.display = "block";
    box.scrollIntoView({ behavior: "smooth" });
}

function confirmDelete(uuid) {
    if (!confirm("Delete this bot permanently?")) return;
    const form = document.createElement("form");
    form.method = "POST";
    form.action = "/admin-panel/bots/" + uuid + "/delete";
    const csrf = document.createElement("input");
    csrf.type = "hidden";
    csrf.name = "csrf";
    csrf.value = "{{ .csrf }}";
    form.appendChild(csrf);
    document.body.appendChild(form);
    form.submit();
}
</script>
{{ end }}
{{ template "footer" . }}

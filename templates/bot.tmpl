{{ template "header" . }}
{{ template "nav" . }}
{{ template "status" . }}

{{ if not .isLogged }}
<article style="text-align:center; margin-top:10vh;">
  <strong>Not authenticated</strong>
  <p>Please log in.</p>
</article>

{{ else }}

<article style="
  max-width:600px;
  margin:40px auto;
  padding:24px;
  border-radius:12px;
  box-shadow:0 10px 30px rgba(0,0,0,0.4);
  display:flex;
  flex-direction:column;
  gap:16px;
">

  <div>
    <strong>{{ .bot.Name }}</strong><br>
    <small>UUID: {{ .bot.UUID }}</small><br>
    <small>Public Key:</small>
    <div style="
      margin-top:4px;
      padding:8px;
      border:1px solid #374151;
      border-radius:6px;
      word-break:break-all;
      font-size:12px;
    ">
      {{ .bot.PublicKey }}
    </div>
  </div>

  <!-- UPDATE NAME -->
  <form method="POST" action="/admin-panel/bots/{{ .bot.UUID }}/update"
        style="display:flex; flex-direction:column; gap:8px;">
    <input type="hidden" name="csrf" value="{{ .csrf }}">

    <label>
      Update Name
      <input name="name" required value="{{ .bot.Name }}"
        style="width:100%; padding:8px; margin-top:4px;">
    </label>

    <button type="submit" style="padding:10px;">
      Save
    </button>
  </form>

  <!-- DELETE -->
  <form method="POST" action="/admin-panel/bots/{{ .bot.UUID }}/delete">
    <input type="hidden" name="csrf" value="{{ .csrf }}">

    <button type="submit"
      style="
        padding:10px;
        background:#7f1d1d;
        color:white;
        border:none;
        border-radius:6px;
      ">
      Delete Bot
    </button>
  </form>

  <!-- BACK -->
  <a href="/admin-panel/bots"
     style="margin-top:8px; text-decoration:none;">
    ← Back to list
  </a>

</article>

{{ end }}

{{ template "footer" . }}

{{ template "header" . }}
{{ template "nav" . }}
{{ template "status" . }}

{{ if not .isLogged }}
<article>
    <strong>Not authenticated</strong>
</article>
{{ else }}

<article>
    <header>
        <h2>
            {{ .bot.Name }}
            <small>[{{ if .isRunning }}Online{{ else }}Offline{{ end }}]</small>
        </h2>
        <code>ID: {{ .bot.UUID }}</code>
    </header>

    <nav>
        <!-- Start/Stop Toggle based on Memory Map -->
        {{ if .isRunning }}
        <form action="/admin-panel/bots/{{ .bot.UUID }}/stop" method="POST" onsubmit="handleAsyncSubmit(this)">
            <input type="hidden" name="csrf" value="{{ .csrf }}">
            <button type="submit">Stop Worker</button>
        </form>
        {{ else }}
        <form action="/admin-panel/bots/{{ .bot.UUID }}/start" method="POST" onsubmit="handleAsyncSubmit(this)">
            <input type="hidden" name="csrf" value="{{ .csrf }}">
            <button type="submit">Run Worker</button>
        </form>
        {{ end }}

        <form action="/admin-panel/bots/{{ .bot.UUID }}/verify" method="POST" onsubmit="handleAsyncSubmit(this)">
            <input type="hidden" name="csrf" value="{{ .csrf }}">
            <button type="submit">Verify Credentials</button>
        </form>

        <a href="/admin-panel/bots/{{ .bot.UUID }}/on-message">On Message (X -> Y)</a>
        <a href="/admin-panel/bots/{{ .bot.UUID }}/on-time">On Time (time -> Y)</a>

        <a href="https://discord.com/api/oauth2/authorize?client_id={{ .bot.ClientID }}&permissions=8&scope=bot%20applications.commands" target="_blank">
            Invite Link
        </a>
    </nav>

    <hr>

    <section>
        <form method="POST" action="/admin-panel/bots/{{ .bot.UUID }}/update">
            <input type="hidden" name="csrf" value="{{ .csrf }}">
            <label for="bot-name">Rename Bot</label>
            <input id="bot-name" name="name" required value="{{ .bot.Name }}">
            <button type="submit">Save</button>
        </form>
    </section>

    <section>
        <form method="POST" action="/admin-panel/bots/{{ .bot.UUID }}/delete" onsubmit="return confirm('Kill this bot instance?');">
            <input type="hidden" name="csrf" value="{{ .csrf }}">
            <button type="submit">Delete Bot</button>
        </form>
    </section>

    <footer>
        <a href="/admin-panel/bots">← Back to List</a>
    </footer>
</article>

<script>
    function handleAsyncSubmit(form) {
        const btn = form.querySelector('button');
        if (btn) {
            btn.disabled = true;
            btn.innerText = '...';
        }
    }
</script>
{{ end }}

{{ template "footer" . }}

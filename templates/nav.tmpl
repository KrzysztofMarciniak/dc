{{ define "nav" }}
<nav class="container-fluid" style="display:flex; justify-content:space-between; align-items:flex-start; gap:1rem;">

  <!-- LEFT -->
  <ul style="display:flex; align-items:center; gap:0.75rem; margin:0; padding:0;">
    <li style="display:flex; align-items:center;">
      <strong style="display:inline-flex; align-items:center; gap:0.45rem;">
        Discord Bot Management System
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:block;">
          <path d="M12 8V4H8"/>
          <rect width="16" height="12" x="4" y="8" rx="2"/>
          <path d="M2 14h2"/>
          <path d="M20 14h2"/>
          <path d="M15 13v2"/>
          <path d="M9 13v2"/>
        </svg>
      </strong>
    </li>
  </ul>

  <!-- RIGHT (column) -->
  <div style="display:flex; flex-direction:column; align-items:flex-end; gap:0.4rem;">

    <!-- TOP ROW -->
    <ul style="display:flex; align-items:center; gap:0.5rem; margin:0; padding:0;">
      {{ if .isLogged }}
        <li>
          <a href="/admin-panel" style="display:inline-flex; align-items:center; gap:0.35rem; padding:0.45rem 0.7rem; border-radius:8px; text-decoration:none;">
            Admin Panel
          </a>
        </li>

        <li>
          <form method="GET" action="/logout" style="margin:0;">
            <button type="submit" class="secondary" style="padding:0.45rem 0.7rem; border-radius:8px;">
              Logout
            </button>
          </form>
        </li>
      {{ else }}
        <li>
          <a href="/login" role="button" style="padding:0.45rem 0.7rem; border-radius:8px; text-decoration:none;">
            Login
          </a>
        </li>
      {{ end }}
    </ul>

    <!-- BOTTOM ROW (theme switcher) -->
    <div>
      <details class="dropdown" style="font-size:0.85rem; position:relative;">
        <summary style="display:inline-flex; align-items:center; justify-content:center; padding:0.35rem 0.5rem; border-radius:8px; cursor:pointer; list-style:none;">
          Theme
        </summary>

        <ul style="
          width:max-content;
          min-width:120px;
          display:flex;
          flex-direction:column;
          padding:0.25rem 0;
          margin:0;
          position:absolute;
          right:0;
          top:100%;
          border-radius:10px;
          box-shadow:0 8px 24px rgba(0,0,0,0.12);
          z-index:10;
        ">
          <li><a href="#" data-theme-switcher="auto" style="padding:0.45rem 0.75rem; display:block;">Auto</a></li>
          <li><a href="#" data-theme-switcher="light" style="padding:0.45rem 0.75rem; display:block;">Light</a></li>
          <li><a href="#" data-theme-switcher="dark" style="padding:0.45rem 0.75rem; display:block;">Dark</a></li>
        </ul>
      </details>
    </div>

  </div>
</nav>
{{ end }}

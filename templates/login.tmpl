{{ template "header" . }}
{{ template "nav" . }}
{{ template "status" . }}

{{ if .isLogged }}
  <article>
    <strong>Already logged in</strong>
    <p>Welcome, {{ .auth.Username }}.</p>
  </article>
{{ else }}
  <article>
<form method="POST" action="/login">
  <label>
    Username
    <input type="text" name="username" required>
  </label>

  <label>
    Password
    <input type="password" name="password" required>
  </label>

  <button type="submit">Login</button>
</form>

  </article>
{{end}}

{{ template "footer" . }}

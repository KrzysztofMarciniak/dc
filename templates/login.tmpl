{{ template "header" . }}
{{ template "nav" . }}
{{ template "status" . }}

{{ if .isLogged }}
  <article>
    <strong>Already logged in</strong>
    <p>Welcome, {{ .auth.Username }}.</p>
  </article>
{{ else }}
<article style="
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:16px;
  padding:32px;
  width:320px;
  margin:auto;
  margin-top:10vh;

  border-radius:12px;
  box-shadow:0 10px 30px rgba(0,0,0,0.4);
  font-family:sans-serif;
">
    <svg xmlns="http://www.w3.org/2000/svg"
         width="48" height="48"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round">
      <path d="m10 17 5-5-5-5"/>
      <path d="M15 12H3"/>
      <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
    </svg>
  </div>

  <form method="POST" action="/login" style="
    display:flex;
    flex-direction:column;
    gap:12px;
    width:100%;
  ">
    <input type="hidden" name="csrf" value="{{ .csrf }}">

    <label style="display:flex; flex-direction:column;  font-size:14px;">
      Username
      <input type="text" name="username" required
        style="margin-top:4px; padding:8px; border-radius:6px; border:1px solid #374151;  ">
    </label>

    <label style="display:flex; flex-direction:column;  font-size:14px;">
      Password
      <input type="password" name="password" required
        style="margin-top:4px; padding:8px; border-radius:6px; border:1px solid #374151;  ">
    </label>

    <button type="submit"
      style="margin-top:8px; padding:10px; border:none; border-radius:6px;   cursor:pointer;">
      Login
    </button>
  </form>

</article>
{{end}}

{{ template "footer" . }}
